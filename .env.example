# --- Core Settings ---
SECRET_KEY=yoursecretkeyhere
REVERSE_PROXY=true
WORKERS=1

# --- External Postgres ---
# Replace with your actual external Postgres URI
DATABASE_URL=postgresql://user:pass@external-host:5432/dbname

# --- External S3 Compatible Storage ---
UPLOAD_PROVIDER=s3
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=your-bucket-name
AWS_S3_ENDPOINT_URL=https://s3.amazonaws.com

# --- Logging ---
LOG_FOLDER=/var/log/CTFd
ACCESS_LOG=-
ERROR_LOG=-

# --- Automated Admin Setup ---
PRESET_ADMIN_NAME=admin
PRESET_ADMIN_EMAIL=admin@example.com
PRESET_ADMIN_PASSWORD=password123

# --- lockdown-api (api service) — see LOCKDOWN-API.md ---
# Image tag from agent-lockdown-web monorepo CI (ghcr.io/hexcore-labs/lockdown-api)
LOCKDOWN_API_IMAGE_TAG=development
API_KEY=change-me
LOCKDOWN_PUBLIC_URL=https://your-competition-api.example.com
SNAPSHOTS_DIR=/data/snapshots
SNAPSHOT_MODE=strict
UPLOAD_FOLDER=/var/uploads